# Database
DATABASE_URL=sqlite:///./dawa_dost.db
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sarvam - Document AI (prescription extraction) & Text Translate
SARVAM_API_KEY=

# Sarvam Voice Agents (Samvaad) - https://docs.sarvam.ai/conversations
# This is a SEPARATE API key from SARVAM_API_KEY above, created at
# https://indus.sarvam.ai/samvaad/settings/api-key
SARVAM_VOICE_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
SARVAM_WEBHOOK_SECRET=
# Must be a publicly reachable URL (not localhost) so Sarvam can call your
# webhook back - e.g. an ngrok tunnel in dev, or your Railway/Render URL
# in production.
PUBLIC_BACKEND_URL=

# Application
NEXT_PUBLIC_API_URL=http://localhost:8000
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000

# Frontend only (goes in frontend/.env.local, NOT this file) - Sarvam's
# no-code voice widget embed (https://unpkg.com/sarvam-convai-embed).
# These are intentionally public/client-side per Sarvam's embed design;
# use a narrowly-scoped API key here, separate from SARVAM_VOICE_API_KEY.
# NEXT_PUBLIC_SARVAM_WIDGET_API_KEY=
# NEXT_PUBLIC_SARVAM_APP_ID=
# NEXT_PUBLIC_SARVAM_ORG_ID=
# NEXT_PUBLIC_SARVAM_WORKSPACE_ID=
